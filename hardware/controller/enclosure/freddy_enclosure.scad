// Freddy controller rev A enclosure. Generated by tools/kicad/gen_enclosure.py from design.py.
// Units: mm. Board coordinates: origin at the PCB's top-left corner, head end up.
//
// Two parts split just above the PCB: a shallow base (floor, standoffs, low walls) and a deep lid.
// Each cable lies in a shallow notch in the base rim; the lid's matching notch closes over it,
// so the walls stay solid between openings and the cables get clamped. Four M3x20 screws go up
// through the base standoffs and the PCB's corner holes into posts in the lid: one set of screws
// holds the board and closes the box.
// Render one part with:  openscad -D 'part="base"' -o base.stl freddy_enclosure.scad   (or "lid")

part = "assembly";        // "base", "lid", "assembly" or "exploded"

pcb_w = 100.0; pcb_h = 100.0; pcb_t = 1.6;
gap = 0.75;               // clearance around the PCB
wall = 2.4; floor_t = 2.4; lid_t = 2.0;
standoff_h = 6.0;         // PCB bottom above the floor (through-hole pins stick out ~2.5mm)
split_above = 2.5;        // base rim height above the PCB top (cable notches go this deep)
clear_above = 26.0;       // room above the PCB: upright S7V7F5 (~23.5mm), C1 (10x16 or 10x20)
corner_r = 4.0;
post_d = 7.0;             // lid posts and base standoffs
screw_clear = 3.4;        // M3 clearance through the base
screw_pilot = 2.6;        // M3 self-tapping into the lid posts (or 4.0 for heat-set inserts)

holes = [[4, 4], [96, 4], [4, 96], [96, 96]];        // PCB mounting holes (M3)
// openings: [name, wall, from, to, z_bottom, z_top]   (z above the PCB top)
openings = [["J9 eye switch", "top", 26, 34, 0, 4.5], ["J10 eye LEDs", "top", 37, 45, 0, 4.5], ["J11 eye motor", "top", 48, 56, 0, 4.5], ["J15 speaker", "top", 71, 79, 0, 4.5], ["J14 Qwiic", "top", 84.5, 90.7, 0, 4.5], ["J6 shoulder", "left", 35.3, 43.3, 0, 4.5], ["J7 elbow", "left", 48, 56, 0, 4.5], ["J8 switch", "left", 62, 70.6, 0, 4.5], ["J3 shoulder", "right", 35.3, 43.3, 0, 4.5], ["J4 elbow", "right", 48, 56, 0, 4.5], ["J5 switch", "right", 62, 70.6, 0, 4.5], ["J1 barrel jack", "bottom", 6.6, 18.2, 0, 12.5], ["ESP32 USB-C", "bottom", 37, 63, 9.5, 19], ["J12 trigger", "bottom", 65.6, 73.6, 0, 6], ["J13 PIR", "bottom", 77.5, 85.5, 0, 4.5]];
// lid vents over the warm parts: [x0, y0, x1, y1] board coordinates
vents = [[17, 40, 33, 58], [67, 55, 83, 73], [12, 13, 32, 34]];

in_w = pcb_w + 2*gap; in_h = pcb_h + 2*gap;
out_w = in_w + 2*wall; out_h = in_h + 2*wall;
pcb_top = floor_t + standoff_h + pcb_t;
split_z = pcb_top + split_above;
top_z = pcb_top + clear_above + lid_t;

function bx(x) = wall + gap + x;             // board x -> enclosure x
function by(y) = out_h - (wall + gap + y);   // board y -> enclosure y (board y grows downward)

module rounded(w, h, z, r) {
    hull() for (x = [r, w - r], y = [r, h - r]) translate([x, y, 0]) cylinder(r = r, h = z, $fn = 48);
}

module shell(z0, z1) {   // walls (and nothing else) between two heights
    translate([0, 0, z0]) difference() {
        rounded(out_w, out_h, z1 - z0, corner_r);
        translate([wall, wall, -1]) rounded(in_w, in_h, z1 - z0 + 2, corner_r - wall);
    }
}

module opening(o) {
    wl = o[1]; a = o[2]; b = o[3];
    z0 = pcb_top + o[4]; z1 = pcb_top + o[5];
    if (wl == "top")    translate([bx(a), out_h - wall - 1, z0]) cube([b - a, wall + 2, z1 - z0]);
    if (wl == "bottom") translate([bx(a), -1, z0]) cube([b - a, wall + 2, z1 - z0]);
    if (wl == "left")   translate([-1, by(b), z0]) cube([wall + 2, b - a, z1 - z0]);
    if (wl == "right")  translate([out_w - wall - 1, by(b), z0]) cube([wall + 2, b - a, z1 - z0]);
}

module base() {
    difference() {
        union() {
            rounded(out_w, out_h, floor_t, corner_r);
            shell(0, split_z);
            for (h = holes) translate([bx(h[0]), by(h[1]), 0]) cylinder(d = post_d, h = floor_t + standoff_h, $fn = 40);
            for (y = [out_h * 0.3, out_h * 0.7], s = [0, 1])
                translate([s ? out_w : 0, y, 0]) mirror([s, 0, 0]) ear();
        }
        for (o = openings) opening(o);
        for (h = holes) translate([bx(h[0]), by(h[1]), -1]) {
            cylinder(d = screw_clear, h = floor_t + standoff_h + 2, $fn = 24);
            cylinder(d = 6.2, h = 1 + 1.8, $fn = 32);        // counterbore for the screw head
        }
        // underside art, recessed 0.6mm; mirrored so it reads correctly from below (head end up)
        translate([out_w / 2, out_h / 2, -0.01]) mirror([1, 0, 0]) linear_extrude(0.61) bottom_art();
    }
}

// a friendly teddy bear (recessed shape, face details left raised) and the maker's mark
module teddy() {
    difference() {
        union() {
            circle(r = 14, $fn = 96);                                        // head
            for (sx = [-1, 1]) translate([sx * 11.5, 11]) circle(r = 6, $fn = 64);   // ears
        }
        for (sx = [-1, 1]) translate([sx * 11.5, 11]) circle(r = 3.2, $fn = 48);     // inner ears
        for (sx = [-1, 1]) translate([sx * 5.2, 3]) circle(r = 1.9, $fn = 32);       // eyes
        translate([0, -5]) scale([1, 0.78]) circle(r = 6.5, $fn = 64);              // muzzle
        for (sx = [-1, 1]) translate([sx * 9.6, -4.2]) circle(r = 1.5, $fn = 24);   // cheeks
    }
    translate([0, -3.2]) scale([1.4, 1]) circle(r = 1.6, $fn = 32);                 // nose
    translate([0, -4.6]) square([0.9, 2.2], center = true);                          // nose to mouth
    for (sx = [-1, 1]) translate([sx * 1.9, -6.0]) difference() {                    // smile
        circle(r = 2.2, $fn = 40);
        circle(r = 1.4, $fn = 40);
        translate([-3, -0.3]) square([6, 3]);
    }
}

module bottom_art() {
    translate([0, 16]) teddy();
    translate([0, -12]) text("Freddy 2.0", size = 9, font = "Liberation Sans:style=Bold", halign = "center", valign = "center");
    translate([0, -25]) text("by Tombatron", size = 5.5, font = "Liberation Sans", halign = "center", valign = "center");
}

module ear() {
    difference() {
        translate([-9, -6, 0]) cube([9, 12, 3]);
        translate([-4.5, 0, -1]) cylinder(d = 3.5, h = 5, $fn = 24);
    }
}

module lid() {
    difference() {
        union() {
            translate([0, 0, top_z - lid_t]) rounded(out_w, out_h, lid_t, corner_r);
            shell(split_z, top_z);
            // posts down to the PCB top: they clamp the board against the standoffs
            for (h = holes) translate([bx(h[0]), by(h[1]), pcb_top]) cylinder(d = post_d, h = top_z - pcb_top, $fn = 40);
        }
        for (o = openings) opening(o);
        for (h = holes) translate([bx(h[0]), by(h[1]), pcb_top - 1]) cylinder(d = screw_pilot, h = 14, $fn = 24);
        for (v = vents) for (x = [v[0] + 1.5 : 3.2 : v[2] - 1.5])
            translate([bx(x) - 0.8, by(v[3]), top_z - lid_t - 1]) cube([1.6, v[3] - v[1], lid_t + 2]);
        // labels, recessed into the top
        translate([out_w / 2, out_h - 9, top_z - 0.6]) linear_extrude(1) text("HEAD", size = 5, halign = "center");
        translate([9, out_h / 2, top_z - 0.6]) rotate(90) linear_extrude(1) text("LEFT ARM", size = 4.5, halign = "center");
        translate([out_w - 9, out_h / 2, top_z - 0.6]) rotate(-90) linear_extrude(1) text("RIGHT ARM", size = 4.5, halign = "center");
        translate([bx(12.4), 5, top_z - 0.6]) linear_extrude(1) text("7.2V", size = 4, halign = "center");
        translate([bx(50), 5, top_z - 0.6]) linear_extrude(1) text("USB", size = 4, halign = "center");
        translate([bx(69.6), 5, top_z - 0.6]) linear_extrude(1) text("TRIG", size = 3.5, halign = "center");
        translate([bx(81.5), 5, top_z - 0.6]) linear_extrude(1) text("PIR", size = 3.5, halign = "center");
    }
}

module pcb_ghost() {
    color("green", 0.7) translate([bx(0), by(pcb_h), floor_t + standoff_h]) cube([pcb_w, pcb_h, pcb_t]);
}

if (part == "base") base();
else if (part == "lid") translate([0, 0, top_z]) rotate([180, 0, 0]) translate([0, -out_h, 0]) lid();  // print upside down
else if (part == "exploded") {
    color("#3b3b3b") base();
    translate([0, 0, 12]) pcb_ghost();
    color("#6a6a6a") translate([0, 0, 40]) lid();
} else {
    color("#3b3b3b") base();
    pcb_ghost();
    color("#6a6a6a", 0.95) lid();
}
