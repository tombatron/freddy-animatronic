// Copy this file to secrets.h (same folder) and fill in your WiFi details.
// secrets.h is in .gitignore, so it never ends up on GitHub.
// Without secrets.h, Freddy starts his own access point instead (see AP_SSID below).
#pragma once

#define WIFI_SSID "your-network-name"
#define WIFI_PASS "your-network-password"

// Optional: the access point used when WiFi isn't configured or can't connect.
// #define AP_PASS "pick-8-or-more-chars"
